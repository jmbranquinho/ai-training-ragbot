# Copy to .env (git-ignored) and fill in. Both the Python and .NET versions read this file.

# --- Azure AI Foundry / Azure OpenAI ---
# Endpoint of your resource, e.g. https://my-foundry.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
# Leave empty to sign in with Entra ID instead (`az login`, needs the
# "Cognitive Services OpenAI User" role on the resource). Recommended: no secret on disk.
AZURE_OPENAI_API_KEY=
# Name of the embedding model *deployment* (not necessarily the model name)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Vector size. text-embedding-3-* can return fewer dimensions than their maximum;
# pgvector's HNSW index supports up to 2000, so keep 1536 even for text-embedding-3-large.
EMBEDDING_DIMENSIONS=1536

# --- Local database (defaults match docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ragbot
POSTGRES_USER=ragbot
POSTGRES_PASSWORD=ragbot
